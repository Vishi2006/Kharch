# Kharch v2.0 Environment Configuration
# Add these variables to .env.local locally and in Vercel Project Settings for production

# MongoDB Atlas Connection
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.mongodb.net/kharch

# Session Security Secret
JWT_SECRET=your_super_secret_jwt_key_here

# Google OAuth (GSI) Credentials
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
NEXT_PUBLIC_GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Backend URL: leave unset/empty for Next.js App Router same-origin serverless API routes (/api/...)
# NEXT_PUBLIC_BACKEND_URL=
